PORT=3000
DEVDEPLOY_DATA_DIR=./data

# GitHub Actions macOS provider — a PAT (scopes: repo, workflow) for the GitHub
# account that owns the target repos. Personal repos (Hearth, CardDNA, Family
# Command Center) use the seangommier-hub account; see
# reference-multiple-github-accounts-on-machine memory.
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_WORKFLOW_FILE=ios-unsigned-build.yml
